# Configuration du service (copier en migration.env, ou laisser install.sh le créer)

# Adresse d'écoute : 127.0.0.1 = ce serveur uniquement ; 0.0.0.0 = accessible depuis le réseau
HOST=127.0.0.1
PORT=8000

# Noms / adresses IP par lesquels l'interface est ouverte depuis le réseau (séparés par des virgules).
# Dès qu'une valeur est renseignée, un mot de passe d'accès est obligatoire (./set-password.sh).
MIGRATION_ALLOWED_HOSTS=

# HTTPS (recommandé sur le réseau) : certificat et clé PEM. install.sh peut générer un certificat auto-signé.
TLS_CERT=
TLS_KEY=
